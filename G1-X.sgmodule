[Script]
g1-x = type=http-response,pattern=^https:\/\/one\.google\.com\/_\/(?:.*)\/data\/batchexecute,requires-body=1,max-size=0,script-path=https://cdn.jsdelivr.net/gh/dyss1992/g1-req-probe@master/g1-x.js

[MITM]
hostname = %APPEND% one.google.com

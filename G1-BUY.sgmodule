#!name=G1 BUY
#!desc=只在“发起购买”的请求体里把 Ultra id 换成 90p 候选，方案列表响应不动，避免页面卡加载
#!system=ios

[Script]
g1-buy = type=http-request,pattern=^https:\/\/one\.google\.com\/,requires-body=1,max-size=0,script-path=https://cdn.jsdelivr.net/gh/dyss1992/g1-req-probe@master/g1-buy.js

[MITM]
hostname = %APPEND% one.google.com
